import os
import json
from flask import Flask, request, jsonify
from google import genai
from google.cloud import bigquery

# ── Vertex AI Gemini client ──────────────────────────────────────────────
# NOTE: only ONE client is needed. Your original file created a second,
# non-Vertex client (genai.Client(http_options=...)) and ran a test call
# at import time — that would fire on every Cloud Run cold start using the
# wrong client/credentials and could crash startup. Removed. If you want
# to sanity-check the Gemini connection locally, run it manually in a
# separate script, not inside main.py.
client = genai.Client(
    vertexai=True,
    project=os.environ.get("GOOGLE_CLOUD_PROJECT"),
    location="africa-south1",
)

# ── BigQuery client ───────────────────────────────────────────────────────
# NOTE: BigQuery client now explicitly pinned to "africa-south1" to match
# the Gemini client's region. If your BigQuery DATASET itself is not
# actually located in africa-south1 (check in the BigQuery console —
# dataset location is set at creation and can't be changed after), this
# will cause query errors, since BigQuery jobs must run in the same
# region/multi-region as the dataset they're querying. Confirm with
# Person 1 before relying on this.
bq_client = bigquery.Client(
    project=os.environ.get("GOOGLE_CLOUD_PROJECT"),
    location="africa-south1",
)

# CONFIRM with Person 1: "Runtime-Terror-gradhack26jnb" may be a display
# name rather than the real GCP project ID — double check before demo day,
# since a mismatch here will fail silently as a "table not found" error.
TABLE_REF = "gradhack26jnb-408.HealthyFood.foodCatalogue"

app = Flask(__name__)

PROMPT_TEMPLATE = """You are a recipe assistant. You will only use items marked as healthy in `classification` below, unless the user's pantry requires otherwise.

Catalogue items (from foodCatalogue — retailer, category, subcategory, item_name, item_type, classification):
{catalogue_items}

User's pantry contents:
{pantry_items}

{length_instruction}

Return between 3 and 5 recipes, ordered from best match to worst match for the
user's pantry and catalogue items above. Ensure the recipes are meaningfully
different from each other (different primary ingredients or cooking methods).
Return ONLY valid JSON in this shape, with no markdown fences or extra text:
{{
  "recipes": [
    {{
      "recipe_title": string,
      "ingredients_used": [string],
      "ingredients_missing": [string],
      "steps": [string]
    }}
  ]
}}
"""

# ── Recipe length options ────────────────────────────────────────────────
# Keeping wording here (not inline in the route) makes it easy to tune
# without touching endpoint logic. If Gemini doesn't respect the numeric
# limits during testing, tighten the wording (e.g. add "STRICT maximum").
LENGTH_INSTRUCTIONS = {
    "short": (
        "Keep EACH recipe SHORT and simple: no more than 5 ingredients "
        "and no more than 4 steps. Prioritize quick, low-effort meals."
    ),
    "long": (
        "Make EACH recipe more DETAILED: include richer ingredient variety "
        "and 6-10 clear steps, with brief technique notes where useful "
        "(e.g. how to tell when something is cooked)."
    ),
}
DEFAULT_LENGTH_INSTRUCTION = (
    "Use a standard recipe length for each recipe: roughly 5-8 ingredients and 4-6 steps."
)


def get_catalogue_items(item_names: list[str]) -> list[dict]:
    """
    Given matched item names (from Person 1's till-slip matching step),
    look up their real category/classification from BigQuery so Gemini
    is grounded on actual catalogue data instead of guessing.
    """
    if not item_names:
        return []

    query = f"""
        SELECT retailer, category, subcategory, item_name, item_type, classification
        FROM `{TABLE_REF}`
        WHERE item_name IN UNNEST(@item_names)
    """
    job_config = bigquery.QueryJobConfig(
        query_parameters=[
            bigquery.ArrayQueryParameter("item_names", "STRING", item_names)
        ]
    )
    results = bq_client.query(query, job_config=job_config).result()
    return [dict(row) for row in results]


@app.route("/recipes", methods=["POST"])
def get_recipe():
    data = request.get_json()

    matched_item_names = data.get("matched_items", [])
    pantry_items = data.get("pantry_items", [])

    recipe_length = data.get("recipe_length", "standard")
    length_instruction = LENGTH_INSTRUCTIONS.get(recipe_length, DEFAULT_LENGTH_INSTRUCTION)

    catalogue_items = get_catalogue_items(matched_item_names)

    if not catalogue_items:
        catalogue_items = []

    prompt = PROMPT_TEMPLATE.format(
        catalogue_items=json.dumps(catalogue_items),
        pantry_items=json.dumps(pantry_items),
        length_instruction=length_instruction,
    )

    response = client.models.generate_content(
        model="gemini-3.6-flash",
        contents=prompt,
    )

    try:
        parsed = json.loads(response.text)
        recipes = parsed.get("recipes", [])
        if not recipes:
            return jsonify({"error": "model returned no recipes", "raw": response.text}), 502
    except json.JSONDecodeError:
        return jsonify({"error": "model returned invalid JSON", "raw": response.text}), 502

    return jsonify({"recipes": recipes})


if __name__ == "__main__":
    # Cloud Run injects PORT automatically at deploy time; 8081 is the
    # local dev fallback if PORT isn't set in the environment.
    app.run(host="0.0.0.0", port=int(os.environ.get("PORT", 8081)))
